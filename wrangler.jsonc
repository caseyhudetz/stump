{
  // Renamed to move the app to a fresh origin. Safari had a stored location
  // denial attached to the old stump.*.workers.dev hostname that could not be
  // cleared from inside the page, and permission state is keyed by origin.
  // Do not rename back: the old hostname would inherit the same stored denial.
  "name": "stump-44",
  "compatibility_date": "2026-08-29",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Shared storage for reports. One key holds every mark, merged per site
  // by timestamp, so several people can survey at once without overwriting
  // each other. Without this binding /api/marks answers 503 and the app
  // falls back to device-local storage.
  "kv_namespaces": [
    { "binding": "MARKS", "id": "98d8f5a6c02248d9846899352319ef31" }
  ]
}
